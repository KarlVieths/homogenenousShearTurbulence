! test_kelvin_s2 deck (tests/kelvin_test_unsteady_S2.md): smooth edge, S2 switched on at t = 1.3 (phase of S2 against the shear-periodic shift)
! One column (kx = 2 pi/15, kz = 2 pi/5), S = 1, S2 = 1 sin(2 pi t/5.25) from t = 1.3, nu = 1e-3; G of the column = 0.222.
&mesh  nx = 1, ny = 128, nz = 1, alfa0 = 0.41887902047863906, beta0 = 1.2566370614359172, ly = 2.0 /
&physics  re = 1000, S = 1.0, linear = .true., exact_shift = .true., s2_amplitude = 1, s2_period = 5.25, s2_start = 1.3 /
&time_control  deltat = 0.025, cflmax = 0.0, t_max = 21, nstep = 100000, dt_stat = 1e9, dt_field = 1e9, dt_save = 1e9, time = 0.0, time_from_restart = .false. /
&init  amplitude = 0.05, seed = 1, kpeak = 6.0 /
&production  prod_kc = 1.5, prod_edge = 0.3 /
&kelvin  ix_mode = 1, iz_mode = 1, iy_mode = 1, tol = 1e-05, csv = 'kelvin_s2_b_Gh_start.csv' /
