! test_kelvin_s2 deck (selective_lu_orr.md, section 9): the Orr weight switches from 1 to 0 at t = 15.75 (3 periods)
! kx = 0, S2 = sin(2 pi t/5.25), no filter; the lift-up keeps its weight 1; nu = 1e-3.
&mesh  nx = 1, ny = 128, nz = 1, alfa0 = 0.41887902047863906, beta0 = 1.2566370614359172, ly = 2.0 /
&physics  re = 1000, S = 1.0, linear = .true., exact_shift = .true., s2_amplitude = 1, s2_period = 5.25 /
&time_control  deltat = 0.025, cflmax = 0.0, t_max = 31.5, nstep = 100000, dt_stat = 1e9, dt_field = 1e9, dt_save = 1e9, time = 0.0, time_from_restart = .false. /
&init  amplitude = 0.05, seed = 1, kpeak = 6.0 /
&production  prod_kc = 0, prod_lu = 1, prod_orr = 0, prod_orr_start = 15.75 /
&kelvin  ix_mode = 0, iz_mode = 1, iy_mode = 1, tol = 1e-05, csv = 'kelvin_split_sw_a_orr_osc.csv' /
