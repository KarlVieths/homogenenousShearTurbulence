! test_kelvin_s2 deck (tests/kelvin_test_unsteady_S2.md): smooth edge (0 < G < 1), 10 periods of S T = 1.75
! One column (kx = 0, kz = 2 pi/5), S = 1, S2 = 1 sin(2 pi t/1.75), nu = 1e-3; G of the column = 0.417 (smooth edge).
&mesh  nx = 1, ny = 128, nz = 1, alfa0 = 0.41887902047863906, beta0 = 1.2566370614359172, ly = 2.0 /
&physics  re = 1000, S = 1.0, linear = .true., exact_shift = .true., s2_amplitude = 1, s2_period = 1.75 /
&time_control  deltat = 0.0125, cflmax = 0.0, t_max = 17.5, nstep = 100000, dt_stat = 1e9, dt_field = 1e9, dt_save = 1e9, time = 0.0, time_from_restart = .false. /
&init  amplitude = 0.05, seed = 1, kpeak = 6.0 /
&production  prod_kc = 1.3, prod_edge = 0.3 /
&kelvin  ix_mode = 0, iz_mode = 1, iy_mode = 1, tol = 1e-05 /
