! Definitions
! ------------------------------------
#define cprod(f,g,h) h.REAL=f.REAL*g.REAL; h.IMAG=f.IMAG*g.IMAG
#define cprod3(f,g,k,h) h.REAL=f.REAL*g.REAL*k.REAL; h.IMAG=f.IMAG*g.IMAG*k.IMAG
DERPRODSEXT = STRUCTURED ARRAY(ux2,vx2,wx2,uy2,vy2,wy2,uz2,vz2,wz2,uxvx,uyvy,uzvz,uxwx,uywy,uzwz,vxwx,vywy,vzwz) OF COMPLEX
BALANCE     = STRUCTURED ARRAY(var,prod,psdiss,pstrain,forcingprod) OF ARRAY(1..6) OF REAL

! Variables in memory
! ------------------------------------
ARRAY(0..nxd-1,0..nyd-1)      OF VELOCITY    Vd
ARRAY(0..nxd-1,0..nyd-1)      OF DERIVS      Vderd=0
ARRAY(0..nxd-1,0..nyd-1)      OF DERPRODSEXT Vmderd=0
ARRAY(0..nxd-1,0..nyd-1,1..6) OF COMPLEX     PHIttrspd=0, forcingprodd=0
ARRAY(-1..nz+1)               OF BALANCE     uiuj_budg_prof=0
ARRAY(1..dn)                  OF BALANCE     uiuj_budg_phase=0, uiuj_budg_phase_chunk=0

SUBROUTINE accum_budget()
    uiuj_budg_prof=0
    ! Parseval theorem method for var and pstrain
    LOOP FOR iz=1 TO nz-1 WITH uiuj_budg_prof(iz):
        LOOP FOR ALL ix,iy WITH V(ix,iy,iz),Vder(ix,iy,iz):
            p == pressure(ix,iy,iz)
            c=IF ix=0 THEN 1 ELSE 2
            ! re-stresses
            var(1)=~+c*(u|u).REAL; var(2)=~+c*(v|v).REAL; var(3)=~+c*(w|w).REAL
            var(4)=~+c*(u|v).REAL; var(5)=~+c*(u|w).REAL; var(6)=~+c*(v|w).REAL
            ! pressure strain
            pstrain(1)=~+2*c*[ux|p].REAL; pstrain(4)=~+c*[(uy|p)+(vx|p)].REAL
            pstrain(2)=~+2*c*[vy|p].REAL; pstrain(5)=~+c*[(uz|p)+(wx|p)].REAL
            pstrain(3)=~+2*c*[wz|p].REAL; pstrain(6)=~+c*[(vz|p)+(wy|p)].REAL
        REPEAT
    REPEAT
    ! Pseudo-spectral method for psdiss and PHIttrsp
    LOOP FOR iz=-1 TO nz+1
        LOOP FOR ix=0 TO nx
            ! padded array for velocity derivatives (3/2 rule)
            DO Vderd(ix,iy)=Vder(ix,iy,iz) FOR iy=0 TO ny
            DO Vderd(ix,iy)=0 FOR iy=ny+1 TO nyd-ny-1
            DO Vderd(ix,nyd+iy)=Vder(ix,iy,iz) FOR iy=-ny TO -1
            ! padded array for velocity (3/2 rule)
            DO Vd(ix,iy)=V(ix,iy,iz) FOR iy=0 TO ny
            DO Vd(ix,iy)=0 FOR iy=ny+1 TO nyd-ny-1
            DO Vd(ix,nyd+iy)=V(ix,iy,iz) FOR iy=-ny TO -1
            ! fft to physical space in y (spanwise)
            WITH Vderd(ix,*): INLINE LOOP FOR ii IN (ux,vx,wx,uy,vy,wy,uz,vz,wz); IFT(ii); REPEAT
            WITH Vd(ix,*):    INLINE LOOP FOR i  IN (u,v,w); IFT(i); REPEAT
        REPEAT LOOP
        ! padding
        DO Vd(ix)=0 FOR ix=nx+1 TO nxd-1
        DO Vderd(ix)=0 FOR ix=nx+1 TO nxd-1
        ! compute velocity derivatives products
        DO
            ! fft to physical space in x (streamwise)
            WITH Vderd(*,iy): INLINE LOOP FOR ii IN (ux,vx,wx,uy,vy,wy,uz,vz,wz); RFT(ii); REPEAT
            WITH Vd(*,iy):    INLINE LOOP FOR i  IN (u,v,w); RFT(i); REPEAT
            DO WITH Vderd(ix,iy), Vmderd(ix,iy), Vd(ix,iy):
                ! products
                cprod(ux,ux,ux2);  cprod(uy,uy,uy2);  cprod(uz,uz,uz2);  cprod(vx,vx,vx2);  cprod(vy,vy,vy2);  cprod(vz,vz,vz2)
                cprod(wx,wx,wx2);  cprod(wy,wy,wy2);  cprod(wz,wz,wz2);  cprod(ux,vx,uxvx); cprod(uy,vy,uyvy); cprod(uz,vz,uzvz)
                cprod(ux,wx,uxwx); cprod(uy,wy,uywy); cprod(uz,wz,uzwz); cprod(vx,wx,vxwx); cprod(vy,wy,vywy); cprod(vz,wz,vzwz)
                ! forcing-production
                cprod3(S2_f*(1+I),v,w,forcingprodd(ix,iy,2)) ! vv
                cprod3(S2_f*(1+I),u,w,forcingprodd(ix,iy,4)) ! uv
                cprod3(S2_f*(1+I),w,w,forcingprodd(ix,iy,6)) ! vw
            FOR ALL ix
            ! fft to Fourier space in x
            WITH Vmderd(*,iy): INLINE LOOP FOR iii IN (ux2,vx2,wx2,uy2,vy2,wy2,uz2,vz2,wz2,uxvx,uyvy,uzvz,uxwx,uywy,uzwz,vxwx,vywy,vzwz); HFT(iii); REPEAT
            ! DO HFT(PHIttrspd(*,iy,i)) FOR ALL i
            DO HFT(forcingprodd(*,iy,i)) FOR ALL i
        FOR iy=0 TO nyd-1
        ! fft to Fourier space in y
        DO WITH Vmderd(ix,*): INLINE LOOP FOR iii IN (ux2,vx2,wx2,uy2,vy2,wy2,uz2,vz2,wz2,uxvx,uyvy,uzvz,uxwx,uywy,uzwz,vxwx,vywy,vzwz); FFT(iii); REPEAT
        ! DO FFT(PHIttrspd(ix,*,i)) FOR ALL i
        DO FFT(forcingprodd(ix,*,i)) FOR ALL i
        FOR ix=0 TO nx+1
        
        WITH Vmderd(0,0), uiuj_budg_prof(iz):
            ! dissipation
            psdiss(1)=~+2*nu*REAL[ux2+uy2+uz2]; psdiss(4)=~+2*nu*REAL[uxvx+uyvy+uzvz]
            psdiss(2)=~+2*nu*REAL[vx2+vy2+vz2]; psdiss(5)=~+2*nu*REAL[uxwx+uywy+uzwz]
            psdiss(3)=~+2*nu*REAL[wx2+wy2+wz2]; psdiss(6)=~+2*nu*REAL[vxwx+vywy+vzwz]
            ! de-aliased forcing-production
            forcingprod(1)=~-2*forcingprodd(0,0,1).REAL; forcingprod(4)=~-forcingprodd(0,0,4).REAL
            forcingprod(2)=~-2*forcingprodd(0,0,2).REAL; forcingprod(5)=~-forcingprodd(0,0,5).REAL
            forcingprod(3)=~-2*forcingprodd(0,0,3).REAL; forcingprod(6)=~-forcingprodd(0,0,6).REAL
        END WITH
    REPEAT
    ! Periodic b.c. for stats (stat. homogeneity)
    uiuj_budg_prof(0   ) = uiuj_budg_prof(nz-1)
    uiuj_budg_prof(-1  ) = uiuj_budg_prof(nz-2)
    uiuj_budg_prof(nz  ) = uiuj_budg_prof(1)
    uiuj_budg_prof(nz+1) = uiuj_budg_prof(2)
    ! Integrate over z and accumulate over fields
    LOOP FOR ALL i,j
        uiuj_budg_phase_chunk(phase_num, i, j) = ~+ zintegr(uiuj_budg_prof(*, i, j))/Lz_ext
    REPEAT LOOP
END accum_budget

SUBROUTINE mpi_comm_budget()
    LOOP FOR np = 1 TO dn
        ! MPI sum (mean values available only to process with rank=0)
        DO MPI_Reduce(uiuj_budg_phase_chunk(np, i, j), uiuj_budg_phase(np, i, j), 1, MPI_DOUBLE, MPI_SUM, 0, MPI_COMM_WORLD) FOR ALL i,j

        IF rank=0 THEN
            ! var,psdiss,pstrain,forcingprod
            DO uiuj_budg_phase(np, i, j) = ~/ nf_vec(np) FOR ALL i,j
            ! prod
            WITH uiuj_budg_phase(np):
                prod(1) = - 2*var(5)*S
                prod(2) = - 2*var(6)*S2_m_phase(np)
                prod(3) =   0
                prod(4) = - var(5)*S2_m_phase(np) - var(6)*S
                prod(5) = - var(3)*S
                prod(6) = - var(3)*S2_m_phase(np)
            END WITH
        END IF
    REPEAT LOOP
END mpi_comm_budget

SUBROUTINE write_budget()
    ARRAY(1..6) OF STRING comp_name
    comp_name(1)="uu"; comp_name(2)="vv"; comp_name(3)="ww"
    comp_name(4)="uv"; comp_name(5)="uw"; comp_name(6)="vw"
    STRING filename_budg
    FILE   out_budg
    IF rank=0 THEN
        LOOP FOR i = 1 TO 6
            filename_budg = WRITE(path_to_statistics'budget_'comp_name(i)'.dat')
            out_budg=CREATE(filename_budg)
                WRITE TO out_budg "# phase   uiuj   prod    psdiss  pstrain forcingprod"
                DO WITH uiuj_budg_phase(np):
                    WRITE TO out_budg np,
                                        var(i)         :1.15, prod(i)    :1.15,
                                        psdiss(i)      :1.15, pstrain(i) :1.15,
                                        forcingprod(i) :1.15
                FOR np = 1 TO dn
            CLOSE out_budg
        REPEAT LOOP
    END IF
END write_budget
