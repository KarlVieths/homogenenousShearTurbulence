! Read discretization, physics and time-control parameters for the post
! processor from the flat token file readinput.in, which is GENERATED from
! the new simulation input deck (hst.in, a Fortran namelist) by
! post/cpl/convert_hstin.py.
!
! Rationale: the new simulator (src/hst_io.f90) writes its velocity files in
! the CPL layout and header, so the post-processor reads the fields
! unchanged; only the deck reader needed the new format.  CPL's READ BY NAME
! (scanrec) scans the whole file for `name = value` tokens but halts on the
! `&mesh` / `&physics` / `&time_control` Fortran-namelist delimiters, so it
! cannot parse hst.in verbatim.  convert_hstin.py extracts the values CPL
! needs into readinput.in (flat tokens, in the READ order below).
!
! Axis relabel: hst.in's &mesh uses the NEW-code convention where
!   ny = physical shear points, nz = spanwise Fourier modes.
! The post-processor uses the CPL/field-header convention
!   ny_cpl = spanwise modes (= nz_new),   nz_cpl = ny_new + 1
!   (nx unchanged).
!
! nx/ny/nz are declared as plain INTEGERs (NO CONSTANT) and are READ from
! readinput.in FIRST, so they follow hst.in at runtime.  convert_hstin.py
! emits them already converted to the CPL convention above, ahead of every
! other token, so these globals are set before any field array is built.
! CPL's compiler automatically heap-allocates ARRAY declarations whose bounds
! are not compile-time constants, sizing them from these runtime values.

! ---- Array extents: RUNTIME CPL-convention integers (read first) ---------
! nx, ny, nz come from the &mesh port of convert_hstin.py (see above).
INTEGER nx, ny, nz

! ---- Runtime scalars (kept as non-CONSTANT globals so the renamed new-deck
!      tokens can be mapped onto the legacy names the downstream modules use) --
REAL alpha0, beta0, htcoeff, Re
REAL S
REAL A, T, delta_SL, t0_SL, dt_rise
REAL deltat
REAL cflmax, t_max
REAL dt_field, dt_save, dt_stat, dt_chk_cfl
BOOLEAN time_from_restart
STRING  Vfield

! ---- Scratch names matching hst.in tokens exactly (token == name) ----
REAL   alfa0              ! &mesh alfa0          (new name for alpha0)
REAL   re                 ! &physics re          (new name for Re)
REAL   ystretch           ! &mesh ystretch       (new name for htcoeff)
REAL   s2_amplitude       ! &physics s2_amplitude -> A
REAL   s2_period          ! &physics s2_period    -> T
REAL   s2_start           ! &physics s2_start     -> t0_SL
STRING restart_file       ! &time_control restart_file -> Vfield

! Read from input file.  nx/ny/nz MUST be read first: convert_hstin.py emits
! them as the first three tokens, already in the CPL convention, so they are
! assigned to the runtime globals before any field array is built.
FILE data=OPENRO[IF COMMANDLINE.HI>1 THEN COMMANDLINE(2) ELSE "readinput.in"]
  ! &mesh port ...: nx, ny, nz (CLP convention), then alfa0, beta0, ystretch
  READ BY NAME FROM data nx, ny, nz, alfa0, beta0, ystretch
  ! &physics ...: re, S, s2_amplitude, s2_period, s2_start, ...
  READ BY NAME FROM data re, S, s2_amplitude, s2_period, s2_start
  ! &time_control ...: deltat, cflmax, t_max, dt_stat, dt_field, dt_save,
  !                    time_from_restart
  READ BY NAME FROM data deltat, cflmax
  READ BY NAME FROM data t_max, dt_stat, dt_field, dt_save, time_from_restart
  ! optional trailing string (startup velocity file), looped like the legacy
  ! Vfield read so that a deck without it does not error
  LOOP UNTIL EOF(data) OR READ BY NAME FROM data restart_file
    READ FROM data
  REPEAT
CLOSE data

! --- map new-deck names onto the legacy globals --------------------------
alpha0    = alfa0        ! renamed alfa0 -> alpha0
htcoeff   = ystretch     ! &mesh ystretch -> htcoeff (0 = uniform grid)
Re        = re           ! renamed re    -> Re
! &physics: unsteady spanwise shear S2
A         = s2_amplitude
T         = s2_period
t0_SL     = s2_start
delta_SL  = 0            ! unused by S2config; kept for its legacy slot
! The legacy `dt_rise` (S2 ramp-up duration) has no single token in hst.in
! (only the boolean sl_ramp).  Keep the hard-ramp default (0 = no smooth
! ramp); to enable the smooth ramp add a `s2_rise_dt` token to &physics and
! read it into dt_rise above (token==name).
dt_rise = 0
Vfield = restart_file    ! startup velocity file name (informational)

REAL CONSTANT eps_num=1E-10
INTEGER count
REAL time=0, start_time=0

REAL nu
IF Re>0 THEN
  nu = 1/Re
ELSE
  nu = 0
END IF

REAL S1 = S

