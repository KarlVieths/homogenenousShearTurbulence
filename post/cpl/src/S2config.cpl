REAL omega, S2=0.0, S2_A, S2_A_integral, t0_S2
omega         = 0   ; IF T>0     THEN omega         = 2*PI/T
S2_A          = 0   ; IF A>0     THEN S2_A          = A
S2_A_integral = 0   ; IF T>0     THEN S2_A_integral = S2_A/omega
t0_S2         = time; IF t0_SL>0 THEN t0_S2         = t0_SL

#ifdef num_integration
    REAL S1_old=S1, S2_old=S2
#endif

#ifndef num_integration
    REAL FUNCTION S2_fun(REAL t)
        IF t<t0_S2 THEN
            RESULT=0
        ELSE
            IF omega>eps_num THEN
                RESULT=S2_A*SIN[omega*(t-t0_S2)]
            ELSE
                RESULT=S2_A
            END IF
        END IF
    END S2_fun

    REAL FUNCTION S2_integral_fun(REAL t1,t2)
        IF t1<t0_S2 AND t2<t0_S2 THEN
            RESULT=0
        ELSE IF t1<t0_S2 AND t2>t0_S2 THEN
            IF omega>eps_num THEN
                RESULT=S2_A_integral*{1-COS[omega*(t2-t0_S2)]}
            ELSE
                RESULT=S2_A*(t2-t0_S2)
            END IF
        ELSE
            IF omega>eps_num THEN
                RESULT=S2_A_integral*{COS[omega*(t1-t0_S2)]-COS[omega*(t2-t0_S2)]}
            ELSE
                RESULT=S2_A*(t2-t1)
            END IF
        END IF
    END S2_integral_fun
#else
    REAL FUNCTION smoothstep5(REAL var)
        RESULT = 10*var**3 - 15*var**4 + 6*var**5
    END smoothstep5

    REAL FUNCTION smoothstep5_dot(REAL var)
        RESULT = 30 * var**2 * (1-var)**2
    END smoothstep5_dot

    REAL FUNCTION envelope(REAL t)
        REAL r
        IF t<=t0_S2 THEN
            RESULT = 0
        ELSE IF t>t0_S2 AND t<(t0_S2+dt_rise) THEN
            r = (t - t0_S2)/dt_rise
            RESULT = smoothstep5(r)
        ELSE
            RESULT = 1
        END IF
    END envelope

    REAL FUNCTION envelope_dot(REAL t)
        REAL r
        IF t<=t0_S2 THEN
            RESULT = 0
        ELSE IF t>t0_S2 AND t<(t0_S2+dt_rise) THEN
            r = (t - t0_S2)/dt_rise
            RESULT = smoothstep5_dot(r)/dt_rise
        ELSE
            RESULT = 0
        END IF
    END envelope_dot

    REAL FUNCTION S2_base(REAL t)
        IF omega>eps_num THEN
            RESULT = S2_A*SIN[omega*(t-t0_S2)]
        ELSE
            RESULT = S2_A
        END IF
    END S2_base

    REAL FUNCTION S2_base_dot(REAL t)
        IF omega>eps_num THEN
            RESULT = omega*S2_A*COS[omega*(t-t0_S2)]
        ELSE
            RESULT = 0
        END IF
    END S2_base_dot

    REAL FUNCTION S2_fun(REAL t)
        RESULT = envelope(t)*S2_base(t)
    END S2_fun

    REAL FUNCTION S2_dot_fun(REAL t)
        RESULT = envelope_dot(t)*S2_base(t) + envelope(t)*S2_base_dot(t)
    END S2_dot_fun
#endif
