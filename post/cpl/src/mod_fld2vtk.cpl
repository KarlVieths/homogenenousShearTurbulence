STRING vtk_name
ARRAY(0..nxd-1,0..nyd-1,-1..nz+1) OF VELOCITY Vdd=0
SINGLE tmpu, tmpv, tmpw, tmp
FILE outfile

SUBROUTINE ByteSwap(POINTER TO SINGLE xxx)
    C SECTION
        register char a;
        register char * b = (char *) xxx_;
        register int  i = 0;
        register int  j = sizeof(*xxx_)-1;
        while (i<j)
            {
            a = b[i];
            b[i] = b[j];
            b[j] = a;
            i++, j--;
            }
    END C SECTION
END ByteSwap

SUBROUTINE fld2vtk()
    Vdd=0
    LOOP FOR iz=-1 TO nz+1
        !V(0,0,iz)=0 !Solo fluttuazioni rispetto alla media spaziale
        LOOP FOR ix=0 TO nx
        Vdd(ix,0..ny,iz)=V(ix,0..ny,iz)
        Vdd(ix,nyd+(-ny..-1),iz)=V(ix,-ny..-1,iz)
        WITH Vdd(ix,*,iz): IFT(u); IFT(v); IFT(w) 
        REPEAT
        DO WITH Vdd(*,iy,iz): RFT(u); RFT(v); RFT(w) FOR ALL iy
    REPEAT
    
    outfile=CREATE(vtk_name)
    WRITE TO outfile "# vtk DataFile Version 2.0"
    WRITE TO outfile "DNS vector + lambda2 + vorticity"
    WRITE TO outfile "BINARY"
    WRITE TO outfile "DATASET RECTILINEAR_GRID"
    WRITE TO outfile "DIMENSIONS "2*nxd" "nyd" "nz-1
    WRITE TO outfile "X_COORDINATES "2*nxd" float"
    LOOP FOR ix=0 TO 2*nxd-1
        tmp=SINGLE(2*PI/alpha0*ix/(2*nxd))
        ByteSwap(^tmp); WRITE BINARY TO outfile tmp
    REPEAT
    WRITE TO outfile "Y_COORDINATES "nyd" float"
        LOOP FOR iy=0 TO nyd-1
        tmp=SINGLE(2*PI/beta0*iy/nyd)
        ByteSwap(^tmp); WRITE BINARY TO outfile tmp
    REPEAT
    WRITE TO outfile "Z_COORDINATES "nz-1" float"
        LOOP FOR iz=1 TO nz-1 
        tmp=SINGLE(z(iz) - 1)
        ByteSwap(^tmp); WRITE BINARY TO outfile tmp
    REPEAT
    WRITE TO outfile "POINT_DATA " 2*nxd*nyd*(nz-1)

    WRITE TO outfile "VECTORS velocity float"
    LOOP FOR iz=1 TO nz-1 AND iy=0 TO nyd-1 AND ix=0 TO 2*nxd-1
        tmpu=SINGLE(Vdd(*,iy,iz).u.REALIFIED(ix)); tmpv=SINGLE(Vdd(*,iy,iz).v.REALIFIED(ix)); tmpw=SINGLE(Vdd(*,iy,iz).w.REALIFIED(ix))
        ByteSwap(^tmpu); ByteSwap(^tmpv);ByteSwap(^tmpw); WRITE BINARY TO outfile tmpu,tmpv,tmpw ! VERSIONE CORRETTA!!!!
    REPEAT
    CLOSE outfile
END fld2vtk