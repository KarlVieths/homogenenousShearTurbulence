! 2-B-e050-t30 (stage 2): production filter k_c = 2 pi/sqrt 3 (lambda_c = sqrt 3), edge 0.5, box 10.5 x 3.4641016151377544 x 10.5 (A = 6.06 x 2 x 6.06 lambda_c), Re_c = 3000, theta = 30 deg
! generated by make_runs.py from template.in and manifest.csv; do not edit, edit the template or the manifest and regenerate
! hst input deck.  Fortran namelist; a line starting with ! is a comment.
! Re_c = S_tot lambda_c^2 Re (|S_tot| = 1): `re` is Re_c/3.  Modes stored: 0..nx in x, -nz..nz in z; ny uniform points in y over ly.
! The mesh is 16, 47.5, 24 modes per unit length (x, y, z), times r = max(1, (Re_c/3000)^(3/4)) (the 15 x 2 x 5 campaign's resolution at r = 1).

&mesh
  nx = 168, ny = 165, nz = 252
  alfa0 = 0.5983986006837702    ! 2*pi/lx, lx = 10.5
  beta0 = 0.5983986006837702    ! 2*pi/lz, lz = 10.5
  ly = 3.4641016151377544   ! 2 lambda_c
  ystretch = 0.0                ! tanh clustering of the y points at mid-box (0 = uniform)
  line_chunk = 0                ! x columns per line-solver batch (0 = all on the GPU, 16 on the CPU)
  transport = 'auto'            ! alltoall transport: 'nccl' if built with NCCL=1 and one GPU per rank, else 'mpi'
  npy = 0                       ! y slabs: 0 = the code chooses (1 here; one per node on the branch multinode-y, nproc = npxz * npy)
/

&physics
  re = 1000.0000000000001                   ! 1/nu = Re_c/3
  S = 0.8660254037844387    ! dU/dy = cos(theta), theta = 30 deg
  linear = .false.              ! .true. drops the nonlinear terms (tests)
  exact_shift = .true.          ! .true.: advect unweighted quantities, removes a dy^2 error (FINDINGS.md)
  s2_amplitude = 0.49999999999999994            ! dW/dy = sin(theta), constant
  s2_period = 0.0               !   constant S2
  s2_start = 0.0                !   time at which it switches on
  sl_amplitude = 0.0            ! Stokes layer at mid-box (0 = off): W = A exp(-s) cos(2 pi (t - t0)/T - s),
  sl_period = 1.0               !   s = |y - ly/2|/delta; needs ystretch > 0 to resolve delta
  sl_delta = 0.02
  sl_start = 0.0
  sl_bodyforce = .true.         ! drive it by its body force (else prescribe the profile)
  sl_ramp = .false.             ! cubic ramp over the first period instead of a hard switch-on
/

&time_control
  deltat = 0.0                  ! 0: choose from cflmax every step
  cflmax = 0.7
  t_max = 1400.0
  nstep = 1000000
  wall_max = 0.0                ! stop after this many seconds of wall-clock time and write the restart file (0 = never)
  dt_stat = 0.1                 ! Runtimedata interval
  dt_field = 100.0              ! field snapshot interval (about 0.7 GB each)
  dt_save = 100.0               ! Dati.cart.out restart interval (a wall_max stop also writes it)
  time = 0.0                    ! start time when not restarting
  time_from_restart = .false.   ! .true.: take the clock from the restart file (the job script sets it when it resumes a run)
  restart_file = 'Dati.cart.out'    ! absent in a new run directory: the random field of &init (seed) is generated.  A leftover file
                                    ! here would be read instead, so every run starts in an empty directory.
  timing = .false.              ! .true.: print the time per phase of the substep at the end
/

&init
  amplitude = 0.0007             ! per mode: the seed decks' value (first q2 depends on the number of modes, README)
  seed = 219                      ! one seed per run (the seed ensemble uses 101-104)
  kpeak = 8.0
/

&production
  prod_kc = 3.6275987284684357     ! the mean shear produces only in the columns with sqrt(kx^2 + kz^2) >= prod_kc
  prod_edge = 0.5               ! relative half width of the smoothstep edge (0: step)
/
